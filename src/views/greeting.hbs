<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Templating Test</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      color: #333;
      margin: 0;
      padding: 20px;
      display: grid;
      place-items: center;
    }

    .title {
      color: #2c3e50;
      text-align: center;
    }
  </style>
</head>

<body>
  <h1 class="title">Hello World! I'm {{name}}!</h1>
</body>

</html>